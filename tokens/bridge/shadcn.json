{
  "background": {
    "$type": "color",
    "$value": "{color.surface.page}",
    "$description": "shadcn --background"
  },
  "foreground": {
    "$type": "color",
    "$value": "{color.text.primary}",
    "$description": "shadcn --foreground"
  },
  "card": {
    "$type": "color",
    "$value": "{color.surface.raised}",
    "$description": "shadcn --card"
  },
  "card-foreground": {
    "$type": "color",
    "$value": "{color.text.primary}",
    "$description": "shadcn --card-foreground"
  },
  "popover": {
    "$type": "color",
    "$value": "{color.surface.raised}",
    "$description": "shadcn --popover"
  },
  "popover-foreground": {
    "$type": "color",
    "$value": "{color.text.primary}",
    "$description": "shadcn --popover-foreground"
  },
  "primary": {
    "$type": "color",
    "$value": "{color.surface.action}",
    "$description": "shadcn --primary"
  },
  "primary-foreground": {
    "$type": "color",
    "$value": "{color.text.on-action}",
    "$description": "shadcn --primary-foreground"
  },
  "secondary": {
    "$type": "color",
    "$value": "{color.surface.action-secondary}",
    "$description": "shadcn --secondary"
  },
  "secondary-foreground": {
    "$type": "color",
    "$value": "{color.text.on-action-secondary}",
    "$description": "shadcn --secondary-foreground"
  },
  "muted": {
    "$type": "color",
    "$value": "{color.surface.sunken}",
    "$description": "shadcn --muted"
  },
  "muted-foreground": {
    "$type": "color",
    "$value": "{color.text.muted}",
    "$description": "shadcn --muted-foreground"
  },
  "surface-hover": {
    "$type": "color",
    "$value": "{color.surface.hover}",
    "$description": "extension DS — fond au survol d'une surface. Rôle qui manquait : les composants détournaient --muted, qui est un CREUX décoratif et non un état."
  },
  "accent": {
    "$type": "color",
    "$value": "{color.brand.accent}",
    "$description": "shadcn --accent"
  },
  "accent-foreground": {
    "$type": "color",
    "$value": "{color.text.on-accent}",
    "$description": "shadcn --accent-foreground"
  },
  "destructive": {
    "$type": "color",
    "$value": "{color.status.error}",
    "$description": "shadcn --destructive"
  },
  "destructive-foreground": {
    "$type": "color",
    "$value": "{color.text.inverse}",
    "$description": "shadcn --destructive-foreground — à auditer"
  },
  "border": {
    "$type": "color",
    "$value": "{color.border.default}",
    "$description": "shadcn --border"
  },
  "border-strong": {
    "$type": "color",
    "$value": "{color.border.strong}",
    "$description": "extension DS — bordure porteuse, >= 3:1 contre la page. Porte le survol des boutons sans fond."
  },
  "input": {
    "$type": "color",
    "$value": "{color.border.input}",
    "$description": "shadcn --input"
  },
  "ring": {
    "$type": "color",
    "$value": "{color.border.focus}",
    "$description": "shadcn --ring"
  },
  "success-fill": {
    "$type": "color",
    "$value": "{color.status.success-fill}",
    "$description": "extension DS — remplissage porteur succès (jauges, barres)"
  },
  "warning-fill": {
    "$type": "color",
    "$value": "{color.status.warning-fill}",
    "$description": "extension DS — remplissage porteur avertissement"
  },
  "error-fill": {
    "$type": "color",
    "$value": "{color.status.error-fill}",
    "$description": "extension DS — remplissage porteur erreur"
  },
  "track": {
    "$type": "color",
    "$value": "{color.surface.track}",
    "$description": "extension DS — piste d'une jauge ; PAS --muted, identique à --card en dark"
  },
  "warning": {
    "$type": "color",
    "$value": "{color.status.warning-text}",
    "$description": "extension DS — texte/emphase avertissement, et remplissage du niveau intermédiaire de ProgressBar"
  },
  "info": {
    "$type": "color",
    "$value": "{color.status.info-text}",
    "$description": "extension DS — texte/emphase information, ton `info` de Badge"
  },
  "success": {
    "$type": "color",
    "$value": "{color.status.success-text}",
    "$description": "extension DS — texte/emphase succès (utilisé par KpiCard)"
  },
  "destructive-text": {
    "$type": "color",
    "$value": "{color.status.error-text}",
    "$description": "extension DS — texte/emphase erreur (utilisé par KpiCard)"
  },
  "rating": {
    "$type": "color",
    "$value": "{color.rating.default}",
    "$description": "extension DS — couleur de notation (étoiles pleines), rôle dédié : cf. règle « un rôle manquant = une variable dédiée »"
  },
  "rating-empty": {
    "$type": "color",
    "$value": "{color.rating.empty}",
    "$description": "extension DS — étoile vide, repère décoratif de l'échelle"
  },
  "chart-1": {
    "$type": "color",
    "$value": "{color.chart.1}",
    "$description": "extension DS — tracé série de données 1"
  },
  "radius": {
    "$type": "dimension",
    "$value": "{role.radius.default}",
    "$description": "extension DS — rayon de base (shadcn --radius, dérivé en lg/md/sm par Tailwind)"
  }
}
