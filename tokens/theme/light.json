{
  "color": {
    "surface": {
      "page": {
        "$type": "color",
        "$value": "{color.neutral.50}"
      },
      "default": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "raised": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "overlay": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "sunken": {
        "$type": "color",
        "$value": "{color.neutral.100}"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.neutral.100}"
      },
      "active": {
        "$type": "color",
        "$value": "{color.neutral.200}"
      },
      "brand": {
        "$type": "color",
        "$value": "{color.brand.primary}"
      },
      "brand-hover": {
        "$type": "color",
        "$value": "{color.brand.primary-hover}"
