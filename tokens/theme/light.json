      "inverse": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "brand": {
        "$type": "color",
        "$value": "{color.brand.secondary}"
      },
      "brand-hover": {
        "$type": "color",
        "$value": "{color.brand.secondary-hover}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.aquamarine.600}"
      },
      "on-accent": {
        "$type": "color",
        "$value": "{color.brand.on-accent}"
      },
      "on-action": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Texte sur surface.action. Blanc en light, midnight en dark."
      },
      "on-action-secondary": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Texte sur surface.action-secondary. Blanc en light, midnight en dark."
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{color.neutral.200}"
      },
      "subtle": {
        "$type": "color",
        "$value": "{color.neutral.100}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.neutral.300}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.brand.secondary}",
        "$description": "Anneau de focus clavier. Aquamarine en dark pour contraste sur fond sombre (WCAG 1.4.11)."
      },
      "brand": {
        "$type": "color",
        "$value": "{color.brand.primary}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.brand.accent}"
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.neutral.200}"
      },
      "input": {
        "$type": "color",
        "$value": "{color.neutral.200}",
        "$description": "Bordure des champs de saisie. Mappé sur --input."
      }
    },
    "status": {
      "success": {
        "$type": "color",
        "$value": "{color.success.500}"
