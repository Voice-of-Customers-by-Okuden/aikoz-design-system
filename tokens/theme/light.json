      },
      "warning": {
        "$type": "color",
        "$value": "{color.warning.500}"
      },
      "warning-subtle": {
        "$type": "color",
        "$value": "{color.warning.50}"
      },
      "warning-border": {
        "$type": "color",
        "$value": "{color.warning.300}"
      },
      "error": {
        "$type": "color",
        "$value": "{color.error.500}"
      },
      "error-subtle": {
        "$type": "color",
        "$value": "{color.error.50}"
      },
      "error-border": {
        "$type": "color",
        "$value": "{color.error.300}"
      },
      "error-text": {
        "$type": "color",
        "$value": "{color.error.600}",
        "$description": "Texte/emphase erreur, contraste AA sur surface (error.600 light, .400 dark). Mappé sur --destructive-text."
      },
      "info": {
        "$type": "color",
        "$value": "{color.info.500}"
      },
      "info-subtle": {
        "$type": "color",
        "$value": "{color.info.50}"
      },
      "info-border": {
        "$type": "color",
        "$value": "{color.info.300}"
      }
    },
    "nav": {
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "surface-active": {
        "$type": "color",
        "$value": "{color.neutral.100}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.neutral.200}"
      },
      "on": {
        "$type": "color",
        "$value": "{color.midnight-blue.900}"
      },
      "on-muted": {
        "$type": "color",
        "$value": "{color.neutral.500}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.brand.secondary}"
      }
    },
    "chart": {
      "1": {
        "$type": "color",
        "$value": "{color.ultramarine.500}",
        "$description": "Série de données 1 (tracé). ultramarine.500 light, aquamarine.300 dark — contraste graphique >= 3:1 sur carte. Mappé sur --chart-1."
      }
    },
    "rating": {
      "default": {
        "$type": "color",
        "$value": "{color.warning.600}",
        "$description": "Couleur de notation — étoiles pleines. warning.600 = 3,25:1 sur --card (seuil 3:1, WCAG 1.4.11 : l'étoile porte l'information quand aucun texte ne double la note). Passe, mais DE JUSTESSE au sens du principe 5 d'a11y.md — marge disponible en thématisant : warning.700 monte à 5,13:1 en light."
      },
      "empty": {
        "$type": "color",
        "$value": "{color.neutral.300}",
        "$description": "Étoile vide — repère de l'échelle. 1,92:1, sous 3:1 : assumé décoratif (aria-hidden, le max figure dans l'aria-label). Le passer à neutral.500 donnerait 4,44:1 mais l'étoile vide pèserait presque autant que la pleine."
      }
    }
  }
}
