        "$value": "{color.neutral.200}"
      },
      "input": {
        "$type": "color",
        "$value": "{color.neutral.200}",
        "$description": "Bordure des champs de saisie. Mappé sur --input."
      }
    },
    "status": {
      "success": {
        "$type": "color",
        "$value": "{color.success.500}"
      },
      "success-subtle": {
        "$type": "color",
