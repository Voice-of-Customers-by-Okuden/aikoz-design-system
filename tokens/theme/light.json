      "action": {
        "$type": "color",
        "$value": "{color.brand.primary}",
        "$description": "Surface d'action principale (bouton default). Midnight en light, aquamarine en dark."
      },
      "action-secondary": {
        "$type": "color",
        "$value": "{color.brand.secondary}",
        "$description": "Surface d'action secondaire. Ultramarine en light, bleu pâle en dark."
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.midnight-blue.900}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.neutral.600}"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{color.neutral.500}"
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.neutral.400}"
      },
