{
  "color": {
    "surface": {
      "page": {
        "$type": "color",
        "$value": "{color.midnight-blue.950}"
      },
      "default": {
        "$type": "color",
        "$value": "{color.midnight-blue.900}"
      },
      "raised": {
        "$type": "color",
        "$value": "{color.midnight-blue.800}"
      },
      "overlay": {
        "$type": "color",
        "$value": "{color.midnight-blue.800}"
      },
      "track": {
        "$type": "color",
        "$value": "{color.neutral.700}",
        "$description": "Piste d'une jauge — repère d'échelle. 1,60:1 sur --card. Ne pas utiliser --muted ici : en dark il vaut exactement la couleur de --card (1,00:1), la piste y serait strictement invisible."
      },
      "sunken": {
        "$type": "color",
        "$value": "{color.midnight-blue.950}"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.midnight-blue.800}"
      },
      "active": {
        "$type": "color",
        "$value": "{color.midnight-blue.700}"
      },
      "brand": {
        "$type": "color",
        "$value": "{color.brand.primary}"
      },
      "brand-hover": {
        "$type": "color",
        "$value": "{color.brand.primary-hover}"
      },
      "brand-active": {
        "$type": "color",
        "$value": "{color.brand.primary-active}"
      },
      "brand-subtle": {
        "$type": "color",
        "$value": "{color.midnight-blue.800}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.brand.accent-subtle}"
      },
      "action": {
        "$type": "color",
        "$value": "{color.brand.accent}",
        "$description": "Surface d'action principale (bouton default). Midnight en light, aquamarine en dark."
      },
      "action-secondary": {
        "$type": "color",
        "$value": "{color.ultramarine.225}",
        "$description": "Surface d'action secondaire. Ultramarine en light, bleu pâle en dark."
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.neutral.300}"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{color.neutral.400}"
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.neutral.600}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.neutral.300}",
        "$description": "Texte secondaire discret (muted). Mappé sur --muted-foreground. AUDIT REQUIS : l'ancien bridge utilisait #9ca3af (contraste 6,68:1 audité sur fond dark) ; aucune primitive neutral n'égale cette valeur (la plus proche, neutral.400 #979BA5, est plus sombre — substitution non sûre sans re-mesure du contraste)."
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.midnight-blue.900}"
      },
      "brand": {
        "$type": "color",
        "$value": "{color.brand.secondary}"
      },
      "brand-hover": {
        "$type": "color",
        "$value": "{color.brand.secondary-hover}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.aquamarine.300}"
      },
      "on-accent": {
        "$type": "color",
        "$value": "{color.brand.on-accent}"
      },
      "on-action": {
        "$type": "color",
        "$value": "{color.midnight-blue.900}",
        "$description": "Texte sur surface.action. Blanc en light, midnight en dark."
      },
      "on-action-secondary": {
        "$type": "color",
        "$value": "{color.midnight-blue.900}",
        "$description": "Texte sur surface.action-secondary. Blanc en light, midnight en dark."
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{color.midnight-blue.700}"
      },
      "subtle": {
        "$type": "color",
        "$value": "{color.midnight-blue.800}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.midnight-blue.600}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.brand.accent}",
        "$description": "Anneau de focus clavier. Aquamarine en dark pour contraste sur fond sombre (WCAG 1.4.11)."
      },
      "brand": {
        "$type": "color",
        "$value": "{color.brand.primary}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.brand.accent}"
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.midnight-blue.700}"
      },
      "input": {
        "$type": "color",
        "$value": "{color.midnight-blue.700}",
        "$description": "Bordure des champs de saisie. Mappé sur --input."
      }
    },
    "status": {
      "success": {
        "$type": "color",
        "$value": "{color.success.400}"
      },
      "success-subtle": {
        "$type": "color",
        "$value": "{color.success.950}"
      },
      "success-border": {
        "$type": "color",
        "$value": "{color.success.700}"
      },
      "success-text": {
        "$type": "color",
        "$value": "{color.success.400}",
        "$description": "Texte/emphase succès, contraste AA sur surface (success.600 light, .400 dark). Mappé sur --success."
      },
      "warning": {
        "$type": "color",
        "$value": "{color.warning.400}"
      },
      "warning-subtle": {
        "$type": "color",
        "$value": "{color.warning.950}"
      },
      "warning-border": {
        "$type": "color",
        "$value": "{color.warning.700}"
      },
      "warning-text": {
        "$type": "color",
        "$value": "{color.warning.400}",
        "$description": "Texte/emphase avertissement et remplissage porteur (warning.600 light, .400 dark), aligné sur success-text et error-text. Mappé sur --warning. Distinct de --rating, qui reste en 600 dans les deux thèmes : une étoile garde son doré, un avertissement s'inverse comme les autres statuts."
      },
      "error": {
        "$type": "color",
        "$value": "{color.error.400}"
      },
      "error-subtle": {
        "$type": "color",
        "$value": "{color.error.950}"
      },
      "error-border": {
        "$type": "color",
        "$value": "{color.error.700}"
      },
      "success-fill": {
        "$type": "color",
        "$value": "{color.success.400}",
        "$description": "Remplissage porteur succès — 7,70:1 sur la piste."
      },
      "warning-fill": {
        "$type": "color",
        "$value": "{color.warning.400}",
        "$description": "Remplissage porteur avertissement — 10,45:1 sur la piste."
      },
      "error-fill": {
        "$type": "color",
        "$value": "{color.error.400}",
        "$description": "Remplissage porteur erreur — 5,33:1 sur la piste."
      },
      "error-text": {
        "$type": "color",
        "$value": "{color.error.400}",
        "$description": "Texte/emphase erreur, contraste AA sur surface (error.600 light, .400 dark). Mappé sur --destructive-text."
      },
      "info": {
        "$type": "color",
        "$value": "{color.info.400}"
      },
      "info-text": {
        "$type": "color",
        "$value": "{color.info.400}",
        "$description": "Texte/emphase information (info.600 light, .400 dark), aligné sur success-text, warning-text et error-text. Mappé sur --info. Il manquait : les quatre statuts n'avaient pas tous leur déclinaison texte."
      },
      "info-subtle": {
        "$type": "color",
        "$value": "{color.info.950}"
      },
      "info-border": {
        "$type": "color",
        "$value": "{color.info.700}"
      }
    },
    "nav": {
      "surface": {
        "$type": "color",
        "$value": "{color.midnight-blue.900}"
      },
      "surface-active": {
        "$type": "color",
        "$value": "{color.midnight-blue.800}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.midnight-blue.700}"
      },
      "on": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "on-muted": {
        "$type": "color",
        "$value": "{color.ultramarine.300}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.brand.accent}"
      }
    },
    "chart": {
      "1": {
        "$type": "color",
        "$value": "{color.aquamarine.300}",
        "$description": "Série de données 1 (tracé). ultramarine.500 light, aquamarine.300 dark — contraste graphique >= 3:1 sur carte. Mappé sur --chart-1."
      }
    },
    "rating": {
      "default": {
        "$type": "color",
        "$value": "{color.warning.600}",
        "$description": "Couleur de notation — étoiles pleines. warning.600 : 5,35:1 sur --card, 5,99:1 sur --background, 5,35:1 sur --muted. Conforme sur les trois surfaces — inchangé, seul le light remonte à 700."
      },
      "empty": {
        "$type": "color",
        "$value": "{color.neutral.700}",
        "$description": "Étoile vide — repère de l'échelle. 1,60:1, sous 3:1 : assumé décoratif (aria-hidden, le max figure dans l'aria-label)."
      }
    }
  }
}
